{
  "manifest_version": 3,
  "name": "YouTube Video Whitelist",
  "version": "2.0",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
  {
    "matches": ["*://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }
],
  "action": {
    "default_popup": "request.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
"web_accessible_resources": [
  {
    "resources": ["request.html"],
    "matches": ["<all_urls>"]
  }
]
}
