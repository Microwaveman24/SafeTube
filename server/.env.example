# SafeTube server config — copy to .env and edit (or export these vars directly).
PORT=3000

# Shared secret: the Chrome extension and the dashboard both send this as
# the X-Family-Key header on every /api call. CHANGE THIS.
FAMILY_KEY=changeme123

# Optional: when set, the dashboard pages (/, /index.html, /app.js, …) require
# a parent login. Stored as a salted scrypt hash — never in plaintext.
# Leave empty to keep the dashboard open (home-network use only).
PARENT_PASSWORD=

# Optional: a YouTube Data API v3 key. When set, the server fills in missing
# video titles / channel names on approval requests. Everything works without it.
YOUTUBE_API_KEY=

DB_PATH=./safetube.db
