# SafeTube server config — copy to .env and edit (or export these vars directly).

PORT=3000
DB_PATH=./safetube.db

# REQUIRED. Shared secret the child's extension sends as the X-Family-Key
# header. Make it long and random (e.g. `openssl rand -hex 32`).
FAMILY_KEY=change-this-to-a-long-random-secret

# --- Tamper detection ---
# A device that hasn't sent a heartbeat in this many minutes is treated as
# possibly-tampered (extension disabled/removed, or the PC is just off) and
# the parent is emailed. Minimum 1.
TAMPER_ALERT_AFTER_MINUTES=30
# Minimum hours between repeat alerts for the same quiet device.
ALERT_COOLDOWN_HOURS=12
# How often the watchdog scans for quiet devices.
MONITOR_INTERVAL_MINUTES=5

# --- Email alerts (SMTP) ---
# If SMTP_HOST is empty, no email is sent — alerts are only logged and shown
# in the dashboard. Gmail example: create an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where alert emails go. Defaults to the parent account's email address.
ALERT_EMAIL=

# --- Optional ---
# A YouTube Data API v3 key. When set, the server fills in missing video
# titles / channel names on approval requests. Everything works without it.
YOUTUBE_API_KEY=

# bcrypt cost for parent passwords (higher = slower). 12 is a good default.
BCRYPT_ROUNDS=12
# Set to true when serving the dashboard over HTTPS so the session cookie
# is only sent over secure connections.
COOKIE_SECURE=false
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
